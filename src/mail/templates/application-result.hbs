<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Resultado de tu Solicitud — JustMe</title>
</head>
<body style="margin:0;padding:0;background-color:#f1f5f9;font-family:'Segoe UI',Arial,sans-serif;">
  <table width="100%" cellpadding="0" cellspacing="0" style="background:#f1f5f9;padding:40px 0;">
    <tr>
      <td align="center">
        <table width="560" cellpadding="0" cellspacing="0" style="background:#ffffff;border-radius:20px;overflow:hidden;box-shadow:0 4px 24px rgba(0,0,0,0.08);">

          <!-- Header -->
          <tr>
            <td style="background:linear-gradient(135deg,#b91c1c,#f59e0b);padding:36px 40px;text-align:center;">
              <p style="margin:0;font-size:28px;font-weight:800;color:#fff;letter-spacing:-0.5px;">
                ✨ JustMe
              </p>
              <p style="margin:6px 0 0;color:rgba(255,255,255,0.9);font-size:13px;letter-spacing:1px;text-transform:uppercase;">
                Plataforma de Servicios
              </p>
            </td>
          </tr>

          <!-- Body -->
          <tr>
            <td style="padding:40px 40px 24px;">
              <h1 style="color:#1e293b;font-size:22px;margin:0 0 12px;font-weight:700;">
                Hola, {{name}} 👋
              </h1>
              <p style="color:#64748b;font-size:15px;line-height:1.7;margin:0 0 28px;">
                Queremos informarte sobre el resultado de tu solicitud para convertirte en <strong style="color:#1e293b;">Profesional en JustMe</strong>.
              </p>

              {{#if isApproved}}
                <!-- Estado: Aprobado -->
                <div style="background:#f0fdf4;border:1.5px solid #86efac;border-radius:12px;padding:28px;text-align:center;margin:0 0 28px;">
                  <p style="margin:0 0 8px;color:#166534;font-size:12px;letter-spacing:2px;text-transform:uppercase;">
                    Estado de tu solicitud
                  </p>
                  <p style="margin:0;font-size:32px;font-weight:800;color:#16a34a;">
                    🎉 Aprobada
                  </p>
                  <p style="margin:12px 0 0;color:#15803d;font-size:14px;line-height:1.6;">
                    ¡Felicidades! Ya eres parte de nuestra red de profesionales.
                  </p>
                </div>
                <p style="color:#64748b;font-size:15px;line-height:1.7;margin:0 0 16px;">
                  Ya puedes acceder al <strong style="color:#1e293b;">Panel de Profesionales</strong> y configurar tus servicios, horarios y perfil público.
                </p>
              {{else}}
                <!-- Estado: Rechazado -->
                <div style="background:#fef2f2;border:1.5px solid #fca5a5;border-radius:12px;padding:28px;text-align:center;margin:0 0 28px;">
                  <p style="margin:0 0 8px;color:#991b1b;font-size:12px;letter-spacing:2px;text-transform:uppercase;">
                    Estado de tu solicitud
                  </p>
                  <p style="margin:0;font-size:32px;font-weight:800;color:#dc2626;">
                    📄 No aprobada
                  </p>
                  <p style="margin:12px 0 0;color:#b91c1c;font-size:14px;line-height:1.6;">
                    Tu solicitud no pudo ser aprobada en esta ocasión.
                  </p>
                </div>
                <p style="color:#64748b;font-size:15px;line-height:1.7;margin:0 0 16px;">
                  Si tienes dudas o deseas más información, puedes contactarnos respondiendo directamente a este correo.
                </p>
              {{/if}}

              {{#if adminMessage}}
                <!-- Mensaje del equipo -->
                <div style="background:#fffbeb;border-left:3px solid #f59e0b;border-radius:0 8px 8px 0;padding:16px 20px;margin:0 0 24px;">
                  <p style="margin:0 0 6px;color:#92400e;font-size:12px;letter-spacing:1.5px;text-transform:uppercase;font-weight:700;">
                    Mensaje del equipo
                  </p>
                  <p style="margin:0;color:#78350f;font-size:14px;line-height:1.7;">
                    {{adminMessage}}
                  </p>
                </div>
              {{/if}}

            </td>
          </tr>

          <!-- Divider -->
          <tr>
            <td style="padding:0 40px;">
              <div style="height:1px;background:#e2e8f0;"></div>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="padding:24px 40px 36px;text-align:center;">
              <p style="margin:0;color:#94a3b8;font-size:12px;">
                © {{year}} JustMe · Todos los derechos reservados<br/>
                <span style="color:#cbd5e1;">justmesoporte@gmail.com</span>
              </p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
