NODE_ENV="prod"

# DATABASE_URL tiene prioridad. Configurar en Render dashboard.
DATABASE_URL=""

POSTGRES_DB="justme_prod_db"
POSTGRES_USER="prod_user"
POSTGRES_PASSWORD="secure_password"
POSTGRES_PORT="5432"
POSTGRES_HOST="postgres"

JWT_SECRET="prod_jwt_secret_change_me"
JWT_EXPIRES_IN="3600"
JWT_REFRESH_SECRET="prod_refresh_secret_change_me"
JWT_REFRESH_EXPIRES_IN="604800"

PLATFORM_COMMISSION_RATE="0.09"
UPLOAD_DIR="./uploads"
CORS_ORIGIN="https://justme.app"

REDIS_URL=""
REDIS_HOST="redis"
REDIS_PORT="6379"
