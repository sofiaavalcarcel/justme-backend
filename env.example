# =============================================================================
# JustMe Backend — Variables de entorno
# =============================================================================
# Local: copia este archivo como `.env` y completa los valores.
# Render: configura estas variables en el dashboard (no subas .env al repo).
# =============================================================================

NODE_ENV=dev
PORT=3000

DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

POSTGRES_DB=justme_db
POSTGRES_USER=root
POSTGRES_PASSWORD=your_password
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

JWT_SECRET=change_me
JWT_EXPIRES_IN=3600
JWT_REFRESH_SECRET=change_me_refresh
JWT_REFRESH_EXPIRES_IN=604800

PLATFORM_COMMISSION_RATE=0.09
UPLOAD_DIR=./uploads
CORS_ORIGIN=http://localhost:5173

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

MAIL_HOST=smtp.gmail.com
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=No Responder - JustMe <noreply@example.com>

REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

OLLAMA_URL=
OLLAMA_MODEL=
