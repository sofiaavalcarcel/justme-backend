# =============================================================================
# JustMe Backend — Variables de entorno
# =============================================================================
# Local: copia este archivo como `.env` y completa los valores.
# Render: configura estas variables en el dashboard (no subas .env al repo).
# =============================================================================

# --- App ---
NODE_ENV=dev
PORT=3000

# --- Base de datos (Neon / Render Postgres) ---
# Si DATABASE_URL está definida, se usa en lugar de POSTGRES_*.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Fallback local (Docker / Postgres local). Solo necesario sin DATABASE_URL.
POSTGRES_DB=justme_db
POSTGRES_USER=root
POSTGRES_PASSWORD=your_password
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# --- JWT ---
JWT_SECRET=change_me
JWT_EXPIRES_IN=3600
JWT_REFRESH_SECRET=change_me_refresh
JWT_REFRESH_EXPIRES_IN=604800

# --- Plataforma ---
PLATFORM_COMMISSION_RATE=0.09
UPLOAD_DIR=./uploads
CORS_ORIGIN=http://localhost:5173

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local: http://localhost:3000/api/auth/google/callback
# Render: https://TU-SERVICIO.onrender.com/api/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# --- Email (SMTP) ---
MAIL_HOST=smtp.gmail.com
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=No Responder - JustMe <noreply@example.com>

# --- Redis (opcional — Render Redis usa REDIS_URL) ---
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Cloudinary (recomendado en producción; el disco de Render es efímero) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Ollama (solo local; en Render dejar vacío — usa fallback automático) ---
OLLAMA_URL=
OLLAMA_MODEL=
